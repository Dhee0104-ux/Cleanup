{
  "name": "smart-highway-clean-wfm",
  "version": "1.0.0",
  "description": "Smart Highway Cleaning Workforce Management & QR Attendance System",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "client": "vite",
    "build": "tsc && vite build",
    "db:switch:postgres": "node scripts/switch-database.js postgres",
    "db:switch:sqlite": "node scripts/switch-database.js sqlite",
    "db:switch:auto": "node scripts/switch-database.js auto",
    "db:setup:cloud": "node scripts/switch-database.js postgres --push",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "tsx src/tests/run-tests.ts",
    "test:security": "tsx src/tests/security-and-task-api.test.ts",
    "test:dispatch": "tsx src/tests/dispatch.test.ts",
    "test:hierarchy": "tsx src/tests/hierarchy.test.ts",
    "test:tasks": "tsx src/tests/task-management.test.ts",
    "test:load": "tsx src/tests/load-sim.ts",
    "start": "tsx src/server/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.16.0",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}

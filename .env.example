# ==============================================================================
# SMART HIGHWAY CLEANING WORKFORCE MANAGEMENT & QR ATTENDANCE SYSTEM
# ENVIRONMENT CONFIGURATION SPECIFICATION
# ==============================================================================

PORT=4001
NODE_ENV=development
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# FREE WEB-BASED CLOUD DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# OPTION 1: Neon Serverless PostgreSQL (Recommended Free Cloud Web Database - https://neon.tech)
# 1. Sign up for free at https://neon.tech
# 2. Create a project (e.g. "highway-wfm")
# 3. Copy the pooled connection string into DATABASE_URL below:
# DATABASE_URL="postgresql://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DB_TYPE=postgresql

# OPTION 2: Supabase PostgreSQL (Free Cloud Web Database - https://supabase.com)
# 1. Sign up for free at https://supabase.com
# 2. Create a new organization & project
# 3. In Project Settings -> Database -> Connection String (URI, Mode: Transaction or Session):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# DB_TYPE=postgresql

# OPTION 3: Local SQLite (Offline Development Fallback)
DATABASE_URL="file:./dev.db"
DB_TYPE=sqlite

# ------------------------------------------------------------------------------
# SECURITY & CRYPTOGRAPHIC SECRETS
# ------------------------------------------------------------------------------
JWT_SECRET=super-secure-highway-wfm-jwt-secret-key-2026
JWT_EXPIRES_IN=8h
REFRESH_SECRET=super-secure-highway-refresh-secret-2026
REFRESH_EXPIRES_IN=7d
QR_HMAC_SECRET=qr-dynamic-token-hmac-sha256-signing-secret-999

# ------------------------------------------------------------------------------
# DYNAMIC QR ATTENDANCE PARAMETERS
# ------------------------------------------------------------------------------
QR_VALIDITY_SECONDS=45
ENFORCE_GEOFENCE=false
